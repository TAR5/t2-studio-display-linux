# MacBookPro16,1 Radeon Pro 5300M: avoid AMDGPU DPM transitions that can
# cause a hard lock when a high-bandwidth external DisplayPort sink attaches.
SUBSYSTEM=="drm", DRIVERS=="amdgpu", ATTRS{vendor}=="0x1002", ATTRS{device}=="0x7340", ATTRS{subsystem_vendor}=="0x106b", ATTRS{subsystem_device}=="0x0210", ATTR{device/power_dpm_force_performance_level}="high"
